},{"t":"text","s":"nécessaires pour faire valoir mes droits.","x":22,"y":167.9,"fs":12.5,"f":"helvetica","st":"normal","c":[17,17,17]},{"t":"text","s":"Veuillez agir en conséquence.","x":22,"y":180.25,"fs":12.5,"f":"helvetica","st":"normal","c":[17,17,17]},{"t":"text","s":"Je vous prie d'agréer, Madame, Monsieur, mes salutations.","x":22,"y":191.3,"fs":12.5,"f":"helvetica","st":"normal","c":[17,17,17]},{"t":"text","s":"Ottawa, le 17 octobre 2026","x":22,"y":227.4,"fs":10.5,"f":"helvetica","st":"normal","c":[17,17,17]},{"t":"img","h":"275ea737","x":112,"y":222.8,"w":62,"h2":18.6},{"t":"line","x1":112,"y1":242.9,"x2":176,"y2":242.9,"lw":0.25,"c":[136,136,136]},{"t":"text","s":"Jean Tremblay","x":112,"y":248.4,"fs":10.5,"f":"helvetica","st":"bold","c":[17,17,17]},{"t":"line","x1":22,"y1":259.4,"x2":193.9,"y2":259.4,"lw":0.25,"c":[204,204,204]},{"t":"text","s":"Jean Tremblay  ·  123 rue Principale, app. 4  ·  Ottawa (Ontario)  K1P 5W4  ·  jean@exemple.ca  613 555 1234","x":107.95,"y":263.9,"fs":8,"f":"helvetica","st":"normal","c":[102,102,102],"a":"center"},{"t":"text","s":"Modèle gratuit : capycom.ca","x":107.95,"y":267.5,"fs":7.5,"f":"helvetica","st":"normal","c":[153,153,153],"a":"center"}]}],"tient":true}